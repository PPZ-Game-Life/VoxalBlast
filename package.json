{
  "name": "voxalblast",
  "private": true,
  "version": "0.8.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/rule-tests.mjs && node tools/game-session-tests.mjs",
    "test:rules": "node tools/rule-tests.mjs",
    "test:session": "node tools/game-session-tests.mjs",
    "shot": "node tools/screenshot.mjs",
    "probe:intro": "node tools/intro-probe.mjs",
    "probe:swipe": "node tools/swipe-probe.mjs",
    "probe:framing": "node tools/cube-framing-probe.mjs",
    "probe:fragility": "node tools/face-fragility.mjs",
    "probe:shapes": "node tools/shape-geometry.mjs",
    "probe:rescue": "node tools/rescue-probe.mjs",
    "probe:interaction": "node tools/refactor-interaction-probe.mjs",
    "probe:ui": "node tools/refactor-ui-probe.mjs",
    "probe:churn": "node tools/refactor-churn-probe.mjs",
    "gates": "node tools/rule-tests.mjs && node tools/game-session-tests.mjs && node tools/refactor-interaction-probe.mjs && node tools/refactor-ui-probe.mjs && node tools/refactor-churn-probe.mjs",
    "reachability": "node tools/reachability.mjs all"
  },
  "dependencies": {
    "postprocessing": "^6.39.4",
    "three": "^0.172.0",
    "three.quarks": "^0.10.8"
